# =========================================
# Terraform
# =========================================

# Terraform working directory
.terraform/
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log
**/crash.log
**/crash.*.log

# Terraform plan files
*.tfplan
*.plan
tfplan
tfplan.*

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc


